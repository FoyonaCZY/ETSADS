<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>etsads-map-export</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
    <DefaultItemExcludes>$(DefaultItemExcludes);.upstream/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TruckLib" Version="0.5.1" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
